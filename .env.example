# Copy to .env (git-ignored). Never commit real keys.
GEMINI_API_KEY=fake
GEMINI_MODE=mock            # live | mock | record | replay
MODEL_PLAN=gemini-4-argon
MODEL_FAST=gemini-4-hydrogen
MODEL_DEEP=gemini-4-carbon
MODEL_DECIDE=gemini-decision-1
MODEL_BASELINE=gemini-4-neon
DATA_DIR=.data
PORT=3001
# Optional (packages/gemini)
GEMINI_CACHE=1                # 0 disables the .data/cache disk cache
# GEMINI_RECORDINGS_DIR=.data/recordings   # where record writes and replay reads
# GEMINI_MOCK_LATENCY_MS=0    # fake latency per mock call, for the demo panel
# GEMINI_FIXTURES_DIR=        # mock fixtures folder (default packages/gemini/fixtures)
# apps/api: PLAN_PARSER=argon reads uploaded floor plans with Argon (needs GEMINI_MODE=live|record). Unset = fixture plans.
# PLAN_PARSER=argon
# apps/api: PIPELINE=real runs the real pipeline on uploaded videos (needs ffmpeg; set FFMPEG_PATH if it is not on PATH).
# PIPELINE=real
# FFMPEG_PATH=/path/to/ffmpeg
# GEMINI_CONCURRENCY=4       # requests in flight at once (raise to ~12 for faster jobs)
# GEMINI_TIMEOUT_MS=90000     # per request; a hung request is retried instead of freezing the job
# MOVEIN_DAMAGE=off         # skip the move-in damage check (faster; default: both walkthroughs are checked)
# Optional (packages/shop, tenant fix kit via Shop MCP; no key needed)
SHOP_MODE=mock                # live | mock | record | replay
# SHOP_MCP_URL=https://mcp.shop.com/
# SHOP_FIXTURES_DIR=          # mock/record/replay fixtures (default packages/shop/fixtures)
# packages/cart-agent: CART_AGENT_HEADLESS=1 hides the cart agent browser (CI); default is a visible window
# CART_AGENT_HEADLESS=1
