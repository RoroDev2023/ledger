# Copy to .env (git-ignored). Never commit real keys.
GEMINI_API_KEY=fake
GEMINI_MODE=mock            # live | mock | record | replay
MODEL_PLAN=gemini-4-argon
MODEL_FAST=gemini-4-hydrogen
MODEL_DEEP=gemini-4-carbon
MODEL_DECIDE=gemini-decision-1
MODEL_BASELINE=gemini-4-neon
DATA_DIR=.data
PORT=3001
# Optional (packages/gemini)
GEMINI_CACHE=1                # 0 disables the .data/cache disk cache
# GEMINI_RECORDINGS_DIR=.data/recordings   # where record writes and replay reads
# GEMINI_MOCK_LATENCY_MS=0    # fake latency per mock call, for the demo panel
# GEMINI_FIXTURES_DIR=        # mock fixtures folder (default packages/gemini/fixtures)
